---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { ui } from '../data/ui.js';
---

<Base noindex={true}>
  <main id="main" class="not-found">
    <div class="container not-found__inner">
      <h1 class="not-found__code">{ui.notFoundHeading}</h1>
      <h2 class="not-found__title">{ui.notFoundTitle}</h2>
      <p class="not-found__desc">{ui.notFoundDesc}</p>
      <div class="not-found__action">
        <Button href="/" variant="primary" size="md">
          {ui.notFoundBack}
        </Button>
      </div>
    </div>
  </main>
</Base>

<style>
  .not-found {
    min-height: calc(100svh - var(--header-h) - 160px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: var(--section-y);
  }

  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 540px;
    margin-inline: auto;
  }

  .not-found__code {
    font-size: clamp(4rem, 12vw, 7.5rem);
    font-weight: var(--fw-semibold);
    line-height: 1;
    color: var(--accent-text);
    margin: 0;
  }

  .not-found__title {
    font-size: var(--fs-h2);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-tight);
    color: var(--text);
    margin-top: var(--space-4);
    margin-bottom: 0;
  }

  .not-found__desc {
    font-size: var(--fs-body);
    color: var(--text-muted);
    line-height: var(--lh-relaxed);
    margin-top: var(--space-3);
    margin-bottom: 0;
  }

  .not-found__action {
    margin-top: var(--space-6);
  }
</style>
